{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@shared/ui": ["../shared/ui/src/index.ts"],
			"@shared/ui/*": ["../shared/ui/src/*"],
			"@shared/hooks": ["../shared/hooks/src/index.ts"],
			"@shared/hooks/*": ["../shared/hooks/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"global.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next"]
}
