{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@shared/ui": ["../shared/ui/src/index.ts"],
			"@shared/ui/*": ["../shared/ui/src/*"],
			"@shared/hooks": ["../shared/hooks/src/index.ts"],
			"@shared/hooks/*": ["../shared/hooks/src/*"],
			"@shared/form": ["../shared/form/src/index.ts"],
			"@shared/form/*": ["../shared/form/src/*"],
			"@shared/utils": ["../shared/utils/src/index.ts"],
			"@shared/utils/*": ["../shared/utils/src/*"],
			"@shared/types": ["../shared/types/src/index.ts"],
			"@shared/types/*": ["../shared/types/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		"types/**/*.d.ts",
		"src/types/**/*.d.ts"
	],
	"exclude": ["node_modules", ".next", "eslint.config.mjs"]
}
