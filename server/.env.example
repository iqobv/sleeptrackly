NODE_ENV=development

# Server
PORT=5000
MAIN_URL=http://sleeptrackly.local:3000
APP_URL=http://app.sleeptrackly.local:3000
ADMIN_URL=http://admin.sleeptrackly.local:3000

# Swagger
SWAGGER_USER=admin
SWAGGER_PASSWORD=password

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=root
POSTGRES_PASSWORD=123456789
POSTGRES_DB=sleep_tracker
POSTGRES_URI=postgres://root:123456789@localhost:5433/sleep_tracker
DB_CA_CERT_BASE64=LS0tLS1...

# Redis
REDIS_USER=default
REDIS_PASSWORD=123456789
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URI=redis://default:123456789@localhost:6380

# Cookie config
COOKIE_DOMAIN=localhost
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

JWT_ACCESS_SECRET=access_secret
REFRESH_TOKEN_SECRET=refresh_secret

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_S3_API=your_cloudflare_s3_api
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCESS_KEY_ID=your_cloudflare_access_key_id
CLOUDFLARE_ACCESS_SECRET_KEY=your_cloudflare_access_secret_key
R2_BUCKET_NAME=your_r2_bucket_name
CUSTOM_DOMAIN=your_custom_r2_domain

# Google
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT=http://api.sleeptrackly.local:5000/v1/auth/google/callback
GOOGLE_REDIRECT_ORIGIN=http://app.sleeptrackly.local:3000

# SMTP
MAIL_HOST=host
MAIL_PORT=500
MAIL_USER=user
MAIL_PASSWORD=password
MAIL_FROM_NAME=Sleep Tracker
MAIL_FROM_ADDRESS=mail@mail.com

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY_BASE64=your_firebase_private_key_base64
FIREBASE_ICON_URL=your_firebase_icon_url

# Sentry
SENTRY_DSN=https://<>@<>.ingest.de.sentry.io/<>
