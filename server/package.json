	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^11.0.17",
		"@nestjs/schematics": "^11.0.10",
		"@nestjs/testing": "^11.1.17",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.21",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.18.2",
		"@types/jest": "^30.0.0",
		"@types/ms": "^2.1.0",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.5.2",
		"@types/nodemailer": "^7.0.11",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.4.0",
		"jest": "^30.3.0",
		"prettier": "^3.8.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.7",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0"
	},
	"overrides": {
		"ajv": "^8.17.1",
		"minimatch": "^10.2.1",
		"glob": "^10.5.0",
		"lodash": "^4.17.21",
		"picomatch": "^2.3.1",
		"@tootallnate/once": "^3.0.1",
		"http-proxy-agent": "^5.0.0",
		"teeny-request": "^9.0.0",
		"retry-request": "^7.0.2",
		"path-to-regexp": "^8.3.2"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/src/$1",
			"^uuid$": "uuid"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "coverage",
		"testEnvironment": "node",
		"transformIgnorePatterns": [
			"node_modules/(?!(uuid)/)"
		]
	}
}
