{
	"name": "server",
	"version": "1.6.0",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main.js",
		"migrate:local": "ts-node src/data-migration-runner.ts",
		"migrate:deploy": "node dist/src/data-migration-runner.js",
		"lint": "oxlint && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1129.0",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/bullmq": "^11.0.5",
		"@nestjs/common": "^11.2.3",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.3",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.2.3",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-email/render": "^2.1.0",
		"@scalar/nestjs-api-reference": "^1.2.18",
		"@sentry/nestjs": "^10.74.0",
		"axios": "catalog:",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.81.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"connect-redis": "^9.0.0",
		"cookie-parser": "^1.4.7",
		"dayjs": "catalog:",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-basic-auth": "^1.2.1",
		"express-session": "^1.19.0",
		"firebase-admin": "^13.10.0",
		"google-auth-library": "^10.9.1",
		"helmet": "^8.3.0",
		"ipaddr.js": "^2.5.0",
		"ms": "^2.1.3",
		"multer": "^2.3.0",
		"nodemailer": "^9.1.1",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.23.0",
		"prisma": "^7.10.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "^6.9.5",
		"redis": "^5.12.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.35.4",
		"ua-parser-js": "^2.0.10",
		"uuid": "^14.0.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.2",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jest": "^30.0.0",
		"@types/ms": "^2.1.0",
		"@types/multer": "^2.2.0",
		"@types/node": "catalog:",
		"@types/nodemailer": "^7.0.12",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"jest": "^30.5.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^@infra/(.*)$": "<rootDir>/src/infra/$1",
			"^@generated/(.*)$": "<rootDir>/generated/$1",
			"^@api/(.*)$": "<rootDir>/src/api/$1",
			"^@libs/(.*)$": "<rootDir>/src/libs/$1",
			"^@config$": "<rootDir>/src/config/index",
			"^@config/(.*)$": "<rootDir>/src/config/$1",
			"^uuid$": "uuid",
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "coverage",
		"testEnvironment": "node",
		"transformIgnorePatterns": [
			"node_modules/(?!(uuid)/)"
		]
	}
}
