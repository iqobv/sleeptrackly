model Bundle {
  id String @id @default(uuid())

  isLimited     Boolean @default(false) @map("is_limited")
  isShowInStore Boolean @default(true) @map("is_show_in_store")
  isNew         Boolean @default(true) @map("is_new")
  isPopular     Boolean @default(false) @map("is_popular")

  price           Int
  maxStock        Int? @map("max_stock")
  discountedPrice Int? @map("discounted_price")
  soldCount       Int  @default(0) @map("sold_count")

  mediaUrl String @map("media_url")

  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations BundleTranslation[]
  items        ItemInBundle[]

  @@map("bundles")
}
