model ChallengeTask {
  id String @id @default(uuid())

  userChallengeId String @map("user_challenge_id")

  date String @map("date")

  isCompleted Boolean @default(false) @map("is_completed")
  isFailed    Boolean @default(false) @map("is_failed")
  isRecovered Boolean @default(false) @map("is_recovered")

  sleepEntryId String? @map("sleep_entry_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userChallenge UserChallenge @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  sleepEntry    SleepEntry?   @relation(fields: [sleepEntryId], references: [id], onDelete: SetNull)

  @@map("challenge_tasks")
}
