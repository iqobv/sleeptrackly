model Token {
  id String @id @default(uuid())

  userId String? @map("user_id")

  token   String    @unique
  expires DateTime
  type    TokenType

  isUsed Boolean @default(false) @map("is_used")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}
