model Streak {
  id String @id @default(uuid())

  userId String @map("user_id")

  status StreakStatus @default(ACTIVE)

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  lastActivityDate String @map("last_activity_date")

  length       Int @default(0)
  restoresUsed Int @default(0) @map("restores_used")

  lastRestoredAt DateTime? @map("last_restored_at")

  userStats UserStats? @relation("ActiveStreak")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("streaks")
}
