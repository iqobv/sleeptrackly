model Token {
  id String @id @default(uuid())

  userId String? @map("user_id")

  token String    @unique
  type  TokenType

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("tokens")
}
