model User {
  id String @id @default(uuid())

  username String  @unique
  email    String  @unique
  password String?

  emailVerified Boolean @default(false) @map("email_verified")

  role UserRole @default(USER)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  providers               UserProvider[]
  sleepEntries            SleepEntry[]
  sleepStatus             UserSleepStatus?
  challenges              Challenge[]
  avatar                  UserAvatar?
  tokens                  Token[]
  sessions                Session[]
  notifications           Notification[]
  userFcmTokens           UserFcmToken[]
  notificationSettings    UserNotificationSettings?
  globalNotificationReads GlobalNotificationRead[]
  coinTransactions        CoinTransaction[]
  coins                   UserCoin?
  inventory               UserInventory[]
  purchaseHistories       PurchaseHistory[]
  userPrivacySettings     UserPrivacySettings?
  promotionUsages         PromotionUsage[]
  weeklySummaries         WeeklySleepSummary[]
  userAchievements        UserAchievement[]

  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  reportsMade    Report[] @relation("ReportsMade")
  reportsAgainst Report[] @relation("ReportsAgainst")
  reportsViewed  Report[] @relation("ReportsViewed")

  createdSanctions UserSanction[] @relation("CreatedUserSanctions")
  sanctions        UserSanction[] @relation("UserSanctions")

  @@map("users")
}
