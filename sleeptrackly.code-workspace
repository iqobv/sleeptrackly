{
	"folders": [
		{
			"name": "Server",
			"path": "server",
		},
		{
			"name": "Client",
			"path": "client",
		},
		{
			"name": "Admin",
			"path": "admin",
		},
		{
			"name": "Shared: UI",
			"path": "shared/ui",
		},
		{
			"name": "Shared: Utils",
			"path": "shared/utils",
		},
		{
			"name": "Shared: Hooks",
			"path": "shared/hooks",
		},
		{
			"name": "Shared: Form",
			"path": "shared/form",
		},
		{
			"name": "Shared: Tables",
			"path": "shared/tables",
		},
		{
			"name": "Shared: Types",
			"path": "shared/types",
		},
		{
			"name": "Root (Configs)",
			"path": ".",
		},
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"admin": true,
			"client": true,
			"server": true,
			"shared": true,
		},
		"eslint.workingDirectories": [
			{ "pattern": "client" },
			{ "pattern": "admin" },
			{ "pattern": "server" },
			{ "pattern": "shared/*" },
		],
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/dist/**": true,
			"**/.next/**": true,
			"**/generated/**": true,
		},
		"js/ts.tsdk.path": "node_modules/typescript/lib",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit",
		},
		"[prisma]": {
			"editor.defaultFormatter": "Prisma.prisma",
			"editor.formatOnSave": true,
		},
	},
}
